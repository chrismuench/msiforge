<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MsiMaker.App.ViewModels"
        x:Class="MsiMaker.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource AppSurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        Title="MsiMaker" Width="980" Height="620" MinWidth="760" MinHeight="480">

  <DockPanel>

    <!-- ================================================================ chrome -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource ChromePadding}">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Width="28" Height="28">
            <TextBlock Text="M" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource AccentTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="MsiMaker" FontSize="17" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <Border Width="1" Height="16" Background="{DynamicResource BorderSubtleBrush}"
                  VerticalAlignment="Center" />
          <TextBlock Text="Build MSIs that upgrade cleanly in Intune" FontSize="12.5"
                     Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="OpenProjectButton" Content="Open project…" Classes="quiet" />
          <Button Name="SaveProjectButton" Content="Save project…" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- ============================================================ status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,7">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                 Fill="{DynamicResource AccentBrush}" />
        <TextBlock Name="StatusText" Text="Ready" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <TabControl Name="MainTabs">

      <!-- ============================================ Library -->
      <!--
        First, because the cheapest way to package an awkward application is to
        start from somebody who has already been caught by it. The detail pane
        leads with the awkwardness prose for the same reason: the silent
        switches are in a vendor PDF somewhere, the trap is not.
      -->
      <TabItem Header="Library">
        <Grid Margin="{DynamicResource PagePadding}"
              RowDefinitions="Auto,*" ColumnDefinitions="300,16,*">

          <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Classes="h1" Text="Start here" />
            <TextBlock Classes="sub" Margin="0,0,0,10"
                       Text="A recipe is the best start when one fits: a working project for an application that does not package the obvious way, plus the reason it does not. Pick one below, hand it the payload you downloaded, and you get a starting project instead of an afternoon in vendor documentation." />

            <!--
              The other two routes sit on one quiet line rather than as buttons
              of equal weight: the recipe list below is the recommendation, and
              three equal buttons would say the three are interchangeable.
            -->
            <Border Classes="inner" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="hint" Margin="0" VerticalAlignment="Center"
                           Text="Already have one of your own, or packaging something not in the library?" />
                <Button Name="OpenProjectOnLibraryButton" Content="Open project…" />
                <Button Name="StartBlankButton" Content="Start blank" Classes="quiet" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ================================================= recipe list -->
          <Border Grid.Row="1" Grid.Column="0" Classes="card" Margin="0" Padding="0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="RECIPES"
                         Margin="14,13,14,6" />

              <!--
                The library's own location: findable, but folded away by
                default. Expanded it is half the height of this card, and the
                list of recipes is what the card is for.
              -->
              <Border DockPanel.Dock="Bottom" Classes="inner"
                      CornerRadius="0,0,7,7" BorderThickness="0,1,0,0" Padding="8,2">
                <Expander Header="Your own recipes" IsExpanded="False"
                          HorizontalAlignment="Stretch" Background="Transparent"
                          BorderThickness="0" Padding="0">
                  <StackPanel Spacing="2" Margin="0,0,0,8">
                    <SelectableTextBlock Text="{Binding RecipeUserDirectory}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Classes="hint" Margin="0,4,0,0"
                               Text="Drop recipe JSON in that folder and it is read on the next start, or point MSIMAKER_RECIPES at a folder your team shares. A file that reuses a built-in id replaces the built-in one, so a vendor who changes a switch can be corrected today rather than in the next release." />
                    <TextBlock Classes="hint" IsVisible="{Binding HasRecipeProblems}"
                               Foreground="{DynamicResource FailTextBrush}"
                               Text="{Binding RecipeProblems}" />
                    <Button Name="OpenRecipesFolderButton" Content="Show recipes folder"
                            Classes="quiet" Margin="0,8,0,0" HorizontalAlignment="Left" />
                  </StackPanel>
                </Expander>
              </Border>

              <ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}"
                       Background="Transparent" BorderThickness="0" Padding="6,0,6,8">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RecipeRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                      <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Vendor}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <!--
                        The badge rides in the list itself, not only in the
                        detail pane: the choice is made here, so this is where
                        tested and merely transcribed have to be told apart.
                      -->
                      <Border Grid.Column="1" Classes="pill"
                              Classes.pass="{Binding IsVerified}"
                              Classes.warn="{Binding IsUntested}"
                              Margin="8,0,0,0">
                        <TextBlock Classes="pilltext"
                                   Classes.pass="{Binding IsVerified}"
                                   Classes.warn="{Binding IsUntested}"
                                   Text="{Binding Badge}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <!-- =============================================== recipe detail -->
          <DockPanel Grid.Row="1" Grid.Column="2" IsVisible="{Binding HasSelectedRecipe}">

            <!--
              Pinned rather than scrolled away with the prose. The awkwardness
              text is deliberately long, and the action it argues for has to
              stay on screen while it is being read.
            -->
            <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0" Padding="14,12">
              <StackPanel Spacing="6">
                <Button Name="UseRecipeButton" Classes="primary" HorizontalAlignment="Left"
                        Content="{Binding SelectedRecipe.UseLabel}" />
                <TextBlock Classes="hint" Margin="0"
                           Text="This replaces the current project. The template carries a realistic version, which is not necessarily the version you downloaded - set the Version on the Identity tab to the one you actually have, because the ProductCode Intune detects on is derived from it." />
              </StackPanel>
            </Border>

            <ScrollViewer>
            <StackPanel Spacing="0" Margin="0,0,4,0">

              <Border Classes="card">
                <StackPanel Spacing="14">

                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding SelectedRecipe.Name}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Classes="hint" Margin="0"
                               Text="{Binding SelectedRecipe.Vendor}" />
                  </StackPanel>

                  <!-- Verified or untested, stated in full, above everything else. -->
                  <Border Classes="verdict pass"
                          IsVisible="{Binding SelectedRecipe.IsVerified}">
                    <TextBlock Classes="verdicttext pass"
                               Text="VERIFIED - this package was built, installed, upgraded and uninstalled from this repository." />
                  </Border>
                  <Border Classes="verdict warn"
                          IsVisible="{Binding SelectedRecipe.IsUntested}">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="verdicttext warn"
                                 Text="UNTESTED - nobody has run this one." />
                      <TextBlock Classes="verdicttext warn" FontWeight="Normal" FontSize="12.5"
                                 Text="The switches came from vendor documentation and were never built, installed or uninstalled here. Vendor documentation is usually right and occasionally a release out of date, and a wrong silent switch fails quietly across a whole fleet. Install it on one device and uninstall it again before this goes anywhere near a deployment ring." />
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Text="WHY THIS ONE IS AWKWARD" Margin="0" />
                    <TextBlock Classes="prose" Text="{Binding SelectedRecipe.Awkwardness}" />
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Text="WHAT IT BUILDS" Margin="0" />
                    <TextBlock Classes="prose" Text="{Binding SelectedRecipe.Description}" />
                  </StackPanel>

                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="14">
                  <TextBlock Classes="eyebrow" Text="WHERE THE PAYLOAD COMES FROM" Margin="0" />

                  <StackPanel Spacing="4" IsVisible="{Binding SelectedRecipe.HasDownloadUrl}">
                    <TextBlock Classes="label" Text="Download" Margin="0" />
                    <!--
                      Selectable rather than a hyperlink, so the address is
                      always readable and copyable; the button is the only thing
                      that hands anything to the shell, and only http or https.
                    -->
                    <SelectableTextBlock Text="{Binding SelectedRecipe.DownloadUrl}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Name="OpenRecipeUrlButton" Content="Open in browser" Classes="quiet"
                            HorizontalAlignment="Left" Margin="0,4,0,0"
                            IsEnabled="{Binding SelectedRecipe.CanOpenDownloadUrl}" />
                  </StackPanel>

                  <StackPanel Spacing="4" IsVisible="{Binding SelectedRecipe.HasDownloadNotes}">
                    <TextBlock Classes="label" Text="Getting hold of it" Margin="0" />
                    <TextBlock Classes="prose" Text="{Binding SelectedRecipe.DownloadNotes}" />
                  </StackPanel>

                  <StackPanel Spacing="4" IsVisible="{Binding SelectedRecipe.HasSetupFileHint}">
                    <TextBlock Classes="label" Text="What the payload should look like" Margin="0" />
                    <TextBlock Classes="prose" Text="{Binding SelectedRecipe.SetupFileHint}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card" IsVisible="{Binding SelectedRecipe.HasNotes}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="eyebrow" Text="NOTES" Margin="0" />
                  <ItemsControl ItemsSource="{Binding SelectedRecipe.Notes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,7">
                          <TextBlock Grid.Column="0" Text="-" Classes="hint" Margin="0,0,8,0" />
                          <TextBlock Grid.Column="1" Text="{Binding}" Classes="hint" Margin="0"
                                     MaxWidth="660" HorizontalAlignment="Left" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="hint" Margin="0" Text="{Binding SelectedRecipe.Origin}" />
                </StackPanel>
              </Border>

            </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <Border Grid.Row="1" Grid.Column="2" Classes="empty"
                  IsVisible="{Binding !HasSelectedRecipe}" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <TextBlock Classes="empty" FontWeight="SemiBold" Text="No recipe selected" />
              <TextBlock Classes="empty"
                         Text="Choose an application on the left to see why it is awkward and what the recipe does about it." />
            </StackPanel>
          </Border>

        </Grid>
      </TabItem>

      <!-- ============================================ Payload -->
      <TabItem Header="Payload">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Classes="h1" Text="What are you packaging?" />
            <TextBlock Classes="sub"
                       Text="Add the files to install. If the payload is an installer executable, analyse it and MsiMaker will identify the framework and propose the switches that make it run silently." />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="PAYLOAD FILES" Margin="0" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="AddFilesButton" Content="Add files…" />
                  <Button Name="AnalyseButton" Content="Re-analyse…" Classes="quiet" />
                  <Button Name="RemoveFileButton" Content="Remove selected" Classes="quiet" />
                </StackPanel>
                <TextBlock Classes="hint" Margin="0"
                           Text="Adding a .exe or .msi runs the installer detective automatically. Re-analyse only when several installers were added at once and the wrong one was picked." />

                <Border Classes="inner" IsVisible="{Binding HasAnalysis}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding AnalysisSummary}" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Classes="mono" Text="{Binding AnalysisDetail}" />
                  </StackPanel>
                </Border>

                <DataGrid Name="FilesGrid" ItemsSource="{Binding Files}" MinHeight="140" MaxHeight="260"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          IsVisible="{Binding HasFiles}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Installs as" Binding="{Binding Target}" Width="1.1*" />
                    <DataGridTemplateColumn Header="Source" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FileRow">
                          <!-- Elided from the left: the tail of a source path is the part worth reading. -->
                          <TextBlock Text="{Binding Source}" ToolTip.Tip="{Binding Source}"
                                     TextTrimming="PrefixCharacterEllipsis"
                                     VerticalAlignment="Center" Margin="12,0"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
                  </DataGrid.Columns>
                </DataGrid>

                <Border Classes="empty" IsVisible="{Binding !HasFiles}" MinHeight="140" MaxHeight="260">
                  <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="empty" FontWeight="SemiBold" Text="No payload yet" />
                    <TextBlock Classes="empty"
                               Text="Add the installer you want to wrap, plus any config files it needs. An .exe or .msi is analysed the moment it is added." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================ Identity -->
      <TabItem Header="Identity">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="Package identity" />
            <TextBlock Classes="sub"
                       Text="These four values decide whether Intune upgrades your app or quietly ignores it. MsiMaker manages the ProductCode for you." />

            <Border Classes="card">
              <Grid ColumnDefinitions="176,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Product name" Margin="0,7,14,0" />
                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" Margin="0,0,0,14" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Manufacturer" Margin="0,7,14,0" />
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" Margin="0,0,0,14" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Version" Margin="0,7,14,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                  <TextBox Text="{Binding Version}" />
                  <TextBlock Classes="hint" Text="{Binding VersionNote}" />
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="UpgradeCode" Margin="0,7,14,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                  <DockPanel>
                    <Button Name="NewUpgradeCodeButton" Content="New" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox Text="{Binding UpgradeCode}" Classes="mono" />
                  </DockPanel>
                  <TextBlock Classes="hint"
                             Text="Stable for the lifetime of the product. Every version must carry this same value, or the old build is never removed and you end up with two entries in Programs and Features." />
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="ProductCode" Margin="0,7,14,0" />
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,14">
                  <TextBox Text="{Binding ProductCodePreview}" IsReadOnly="True" Classes="mono"
                           Background="{DynamicResource SunkenBrush}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Classes="hint"
                             Text="Derived from the UpgradeCode and version, so it changes exactly when the version changes. Intune detects on this value; a ProductCode that fails to change is the single most common reason an upgrade never happens." />
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Platform" Margin="0,7,14,0" />
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,14">
                  <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}"
                            MinWidth="170" HorizontalAlignment="Left" />
                  <TextBlock Classes="hint"
                             Text="Cannot change between versions of the same product. Windows Installer will not upgrade across architectures." />
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Install folder" Margin="0,7,14,0" />
                <StackPanel Grid.Row="6" Grid.Column="1">
                  <TextBox Text="{Binding InstallFolder}" Watermark="defaults to the product name" />
                  <TextBlock Classes="hint" Text="Created under Program Files. Installs are always per-machine, because Intune runs as SYSTEM." />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================ Run -->
      <TabItem Header="Run">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Classes="h1" Text="Commands to run" />
            <TextBlock Classes="sub"
                       Text="Executables the package runs during install or uninstall. Each runs deferred and without impersonation, so it executes as SYSTEM with the payload already on disk." />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="CUSTOM ACTIONS" Margin="0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="AddRunButton" Content="Add command" />
                  <Button Name="RemoveRunButton" Content="Remove selected" Classes="quiet" />
                </StackPanel>
                <DataGrid Name="RunGrid" ItemsSource="{Binding Run}" MinHeight="150" MaxHeight="280"
                          AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Executable" Binding="{Binding ExePath}" Width="240" />
                    <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="*" />
                    <DataGridCheckBoxColumn Header="Ignore exit code" Binding="{Binding IgnoreExitCode}" Width="140" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Classes="hint" Margin="0"
                           Text="Paths are relative to the install folder. An installer run this way is not tracked by Windows Installer, so uninstalling the MSI removes the payload but not whatever that installer wrote elsewhere - add an uninstall command for that." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================ Upgrade check -->
      <TabItem Header="Upgrade check">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Classes="h1" Text="Will Intune actually upgrade?" />
            <TextBlock Classes="sub"
                       Text="Compare a built package against the version already deployed. Every reason an Intune upgrade silently fails is visible in the two files before anything is deployed." />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="COMPARE AGAINST" Margin="0" />
                <DockPanel>
                  <Button Name="PickPreviousButton" Content="Previously shipped MSI…"
                          DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox Text="{Binding PreviousMsi}" Watermark="path to the MSI currently deployed" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="RunCheckButton" Content="Check against current build" />
                  <Button Name="PickCandidateButton" Content="…or pick a candidate MSI" Classes="quiet" />
                </StackPanel>

                <Border Classes="verdict" Classes.pass="{Binding VerdictIsGood}"
                        IsVisible="{Binding Verdict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Classes="verdicttext" Classes.pass="{Binding VerdictIsGood}"
                             Text="{Binding Verdict}" />
                </Border>

                <DataGrid ItemsSource="{Binding Checks}" MinHeight="150" MaxHeight="300" IsReadOnly="True"
                          AutoGenerateColumns="False" RowHeight="34"
                          IsVisible="{Binding HasChecks}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="86">
                      <DataGridTemplateColumn.CellTemplate>
                        <!--
                          A template column, not a text column: compiled bindings
                          cannot bind a DataGridTextColumn's Foreground to a row
                          property, and the status has to be readable at a glance.
                        -->
                        <DataTemplate x:DataType="vm:CheckRow">
                          <Border Classes="pill"
                                  Classes.pass="{Binding IsPass}"
                                  Classes.warn="{Binding IsWarn}"
                                  Classes.fail="{Binding IsFail}"
                                  MinWidth="48" Margin="12,0,0,0">
                            <TextBlock Classes="pilltext"
                                       Classes.pass="{Binding IsPass}"
                                       Classes.warn="{Binding IsWarn}"
                                       Classes.fail="{Binding IsFail}"
                                       Text="{Binding Mark}" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="200" />
                    <DataGridTemplateColumn Header="Detail" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:CheckRow">
                          <TextBlock Text="{Binding Detail}" ToolTip.Tip="{Binding Detail}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" Margin="12,0"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <Border Classes="empty" IsVisible="{Binding !HasChecks}" MinHeight="140" MaxHeight="220">
                  <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="empty" FontWeight="SemiBold" Text="Nothing compared yet" />
                    <TextBlock Classes="empty"
                               Text="Point at the MSI currently deployed, then check it against this build. Each rule Windows Installer applies to an upgrade is reported as PASS, WARN or FAIL." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================ Build -->
      <TabItem Header="Build">
        <DockPanel Margin="{DynamicResource PagePadding}">

          <!--
            The one action the window exists for, docked rather than scrolled:
            the options above it are long and every hint on them is load-bearing,
            so on a short screen the button would otherwise be below the fold.
          -->
          <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0" Padding="14,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Name="BuildButton" Content="Build MSI" Classes="primary"
                      IsEnabled="{Binding CanBuild}" />
              <Button Name="OpenOutputButton" Content="Show output folder" Classes="quiet" />
            </StackPanel>
          </Border>

          <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="h1" Text="Build" />
            <TextBlock Classes="sub" Text="The MSI is always produced. Everything else is optional." />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="OUTPUT" Margin="0" />
                <DockPanel>
                  <Button Name="PickOutputButton" Content="Output…" DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox Text="{Binding OutputPath}" Watermark="where to write the .msi" />
                </DockPanel>

                <StackPanel Spacing="0">
                  <CheckBox IsChecked="{Binding EmitIntuneWin}" Content="Also produce a Win32 .intunewin package" />
                  <TextBlock Classes="hint" Margin="28,2,0,6"
                             Text="Not needed just to deploy an MSI: Intune reads the ProductCode itself and a line-of-business MSI upgrades on GUID and version alone. Choose this when you need something LOB MSI cannot do - supersedence, dependencies, requirement rules, a custom command line, or detection beyond the ProductCode." />
                  <TextBlock Classes="hint" Margin="28,0,0,0" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="Required for ring-based rollout: Intune deployment plans accept only Windows app (Win32) and Enterprise App Catalog payloads. A line-of-business MSI cannot be used in a deployment, and only the Required install intent is supported." />
                </StackPanel>

                <Separator Margin="0,6" />

                <!-- ========================================= signing -->
                <TextBlock Classes="eyebrow" Text="SIGNING" Margin="0" />

                <StackPanel Spacing="0">
                  <CheckBox IsChecked="{Binding SignEnabled}" Content="Sign the package" />
                  <TextBlock Classes="hint" Margin="28,2,0,0"
                             Text="Signing runs after the MSI is written and before anything is packaged around it, because any later edit to the database invalidates the signature." />
                </StackPanel>

                <StackPanel Spacing="14" Margin="28,6,0,0" IsVisible="{Binding SignEnabled}">

                  <!--
                    Availability first. Every mode drives an external signer, so
                    a missing one is the single failure that makes the rest of
                    this section pointless, and it is invisible otherwise.
                  -->
                  <Border Classes="inner">
                    <StackPanel Spacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="pill"
                                Classes.pass="{Binding SignerFound}"
                                Classes.fail="{Binding !SignerFound}">
                          <TextBlock Classes="pilltext"
                                     Classes.pass="{Binding SignerFound}"
                                     Classes.fail="{Binding !SignerFound}"
                                     Text="{Binding SignerBadge}" />
                        </Border>
                        <TextBlock Text="Signer" Classes="label" Margin="0" VerticalAlignment="Center" />
                        <Button Name="RecheckSignerButton" Content="Check again" Classes="quiet" />
                      </StackPanel>
                      <TextBlock Classes="mono" Text="{Binding SignerStatus}" />
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="Key material" Margin="0" />
                    <ComboBox ItemsSource="{Binding SigningModeNames}"
                              SelectedItem="{Binding SigningModeName}"
                              MinWidth="240" HorizontalAlignment="Left" />
                  </StackPanel>

                  <!-- PFX file -->
                  <StackPanel Spacing="14" IsVisible="{Binding IsPfxMode}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="Certificate file (.pfx)" Margin="0" />
                      <DockPanel>
                        <Button Name="PickCertificateButton" Content="Certificate…"
                                DockPanel.Dock="Right" Margin="8,0,0,0" />
                        <TextBox Text="{Binding CertificatePath}"
                                 Watermark="path to the PFX to sign with" />
                      </DockPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <!--
                        The single most dangerous field in the window. It is
                        named for what it takes - a variable name - in the label,
                        the watermark and the hint, because a password typed here
                        would be written into the project file and committed.
                      -->
                      <TextBlock Classes="label" Margin="0"
                                 Text="Name of the environment variable holding the password" />
                      <TextBox Text="{Binding PasswordEnvironmentVariable}" Classes="mono"
                               Watermark="for example MSIMAKER_PFX_PASSWORD" />
                      <TextBlock Classes="hint" Margin="0"
                                 Text="This is a variable name, not the password. MsiMaker reads the password from that variable on the machine doing the build, and never stores it. A project file belongs in source control, and a secret written into one would go to source control with it - which is why there is no password box here and no password field in the project format." />
                    </StackPanel>
                  </StackPanel>

                  <!-- Windows certificate store -->
                  <StackPanel Spacing="4" IsVisible="{Binding IsStoreMode}">
                    <TextBlock Classes="label" Text="Certificate thumbprint" Margin="0" />
                    <TextBox Text="{Binding Thumbprint}" Classes="mono"
                             Watermark="SHA-1 thumbprint of a certificate in the Windows store" />
                    <TextBlock Classes="hint" Margin="0"
                               Text="The certificate must already be installed on the machine doing the build, in a store the build account can read. Nothing secret is stored in the project: only the thumbprint that selects it." />
                  </StackPanel>

                  <!-- Azure Trusted Signing -->
                  <StackPanel Spacing="14" IsVisible="{Binding IsAzureMode}">

                    <Border Classes="verdict warn">
                      <StackPanel Spacing="5">
                        <TextBlock Classes="verdicttext warn"
                                   Text="Implemented, but never verified against a real account." />
                        <TextBlock Classes="verdicttext warn" FontWeight="Normal" FontSize="12.5"
                                   Text="The command line signtool is given is covered by tests, but no package has been signed through an actual Trusted Signing account from here. Treat the first run as something to prove on one package, not as a step in a fleet build." />
                        <TextBlock Classes="verdicttext warn" FontWeight="Normal" FontSize="12.5"
                                   Text="Credentials are not project settings and cannot be entered here. They come from the ambient Azure credential chain - AZURE_TENANT_ID, AZURE_CLIENT_ID and AZURE_CLIENT_SECRET, or an interactive az login - so the private key never reaches the build machine at all." />
                      </StackPanel>
                    </Border>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="Account endpoint" Margin="0" />
                      <TextBox Text="{Binding AzureEndpoint}" Classes="mono"
                               Watermark="https://eus.codesigning.azure.net/" />
                      <TextBlock Classes="hint" Margin="0"
                                 Text="The region in the host must match the region the Trusted Signing account was created in." />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="Code signing account name" Margin="0" />
                      <TextBox Text="{Binding AzureCodeSigningAccountName}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="Certificate profile name" Margin="0" />
                      <TextBox Text="{Binding AzureCertificateProfileName}" />
                      <TextBlock Classes="hint" Margin="0"
                                 Text="The profile, not the project, decides which identity the signature carries." />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="Dlib path (optional)" Margin="0" />
                      <DockPanel>
                        <Button Name="PickDlibButton" Content="Dlib…"
                                DockPanel.Dock="Right" Margin="8,0,0,0" />
                        <TextBox Text="{Binding AzureDlibPath}" Classes="mono"
                                 Watermark="leave empty to find Azure.CodeSigning.Dlib.dll in the NuGet cache" />
                      </DockPanel>
                      <TextBlock Classes="hint" Margin="0"
                                 Text="Only needed when the Microsoft.Trusted.Signing.Client package sits somewhere the NuGet cache sweep will not look. Signing goes through signtool's dlib hook, so this mode needs the Windows SDK; osslsigncode cannot do it." />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="Timestamp URL" Margin="0" />
                    <TextBox Text="{Binding TimestampUrl}" Classes="mono"
                             Watermark="http://timestamp.digicert.com" />
                    <TextBlock Classes="hint" Margin="0"
                               Text="Without a timestamp the signature stops being trusted the day the certificate expires, rather than covering everything signed while it was valid." />
                  </StackPanel>

                </StackPanel>

              </StackPanel>
            </Border>

            <!--
              Collapsed by default and modest when open: on a short window the
              log used to push the Build button off the bottom of the screen,
              and it has nothing in it until a build has run anyway.
            -->
            <Expander Name="LogExpander" Header="Log" IsExpanded="False"
                      HorizontalAlignment="Stretch" Margin="0,0,0,16">
              <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                       Classes="mono" MinHeight="110" MaxHeight="220"
                       Background="{DynamicResource SunkenBrush}"
                       TextWrapping="NoWrap"
                       HorizontalAlignment="Stretch" VerticalContentAlignment="Top" />
            </Expander>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
