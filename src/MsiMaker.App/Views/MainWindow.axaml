<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MsiMaker.App.ViewModels"
        x:Class="MsiMaker.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource AppSurfaceBrush}"
        Title="MsiMaker" Width="1080" Height="740" MinWidth="820" MinHeight="600">

  <DockPanel>

    <!-- ================================================================ chrome -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource ChromePadding}">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Width="28" Height="28">
            <TextBlock Text="M" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource AccentTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="MsiMaker" FontSize="17" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <Border Width="1" Height="16" Background="{DynamicResource BorderSubtleBrush}"
                  VerticalAlignment="Center" />
          <TextBlock Text="Build MSIs that upgrade cleanly in Intune" FontSize="12.5"
                     Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="OpenProjectButton" Content="Open project…" Classes="quiet" />
          <Button Name="SaveProjectButton" Content="Save project…" />
        </StackPanel>

      </Grid>
    </Border>

    <!-- ============================================================ status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,7">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                 Fill="{DynamicResource AccentBrush}" />
        <TextBlock Name="StatusText" Text="Ready" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <TabControl>

      <!-- ============================================ Payload -->
      <TabItem Header="Payload">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Classes="h1" Text="What are you packaging?" />
            <TextBlock Classes="sub"
                       Text="Add the files to install. If the payload is an installer executable, analyse it and MsiMaker will identify the framework and propose the switches that make it run silently." />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="PAYLOAD FILES" Margin="0" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="AddFilesButton" Content="Add files…" />
                  <Button Name="AnalyseButton" Content="Re-analyse…" Classes="quiet" />
                  <Button Name="RemoveFileButton" Content="Remove selected" Classes="quiet" />
                </StackPanel>
                <TextBlock Classes="hint" Margin="0"
                           Text="Adding a .exe or .msi runs the installer detective automatically. Re-analyse only when several installers were added at once and the wrong one was picked." />

                <Border Classes="inner" IsVisible="{Binding HasAnalysis}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding AnalysisSummary}" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Classes="mono" Text="{Binding AnalysisDetail}" />
                  </StackPanel>
                </Border>

                <DataGrid Name="FilesGrid" ItemsSource="{Binding Files}" Height="230"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          IsVisible="{Binding HasFiles}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Installs as" Binding="{Binding Target}" Width="1.1*" />
                    <DataGridTemplateColumn Header="Source" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FileRow">
                          <!-- Elided from the left: the tail of a source path is the part worth reading. -->
                          <TextBlock Text="{Binding Source}" ToolTip.Tip="{Binding Source}"
                                     TextTrimming="PrefixCharacterEllipsis"
                                     VerticalAlignment="Center" Margin="12,0"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
                  </DataGrid.Columns>
                </DataGrid>

                <Border Classes="empty" IsVisible="{Binding !HasFiles}" Height="230">
                  <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="empty" FontWeight="SemiBold" Text="No payload yet" />
                    <TextBlock Classes="empty"
                               Text="Add the installer you want to wrap, plus any config files it needs. An .exe or .msi is analysed the moment it is added." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================ Identity -->
      <TabItem Header="Identity">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="Package identity" />
            <TextBlock Classes="sub"
                       Text="These four values decide whether Intune upgrades your app or quietly ignores it. MsiMaker manages the ProductCode for you." />

            <Border Classes="card">
              <Grid ColumnDefinitions="176,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Product name" Margin="0,7,14,0" />
                <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}" Margin="0,0,0,14" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Manufacturer" Margin="0,7,14,0" />
                <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}" Margin="0,0,0,14" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Version" Margin="0,7,14,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                  <TextBox Text="{Binding Version}" />
                  <TextBlock Classes="hint" Text="{Binding VersionNote}" />
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="UpgradeCode" Margin="0,7,14,0" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                  <DockPanel>
                    <Button Name="NewUpgradeCodeButton" Content="New" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox Text="{Binding UpgradeCode}" Classes="mono" />
                  </DockPanel>
                  <TextBlock Classes="hint"
                             Text="Stable for the lifetime of the product. Every version must carry this same value, or the old build is never removed and you end up with two entries in Programs and Features." />
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="ProductCode" Margin="0,7,14,0" />
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,14">
                  <TextBox Text="{Binding ProductCodePreview}" IsReadOnly="True" Classes="mono"
                           Background="{DynamicResource SunkenBrush}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Classes="hint"
                             Text="Derived from the UpgradeCode and version, so it changes exactly when the version changes. Intune detects on this value; a ProductCode that fails to change is the single most common reason an upgrade never happens." />
                </StackPanel>

                <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Platform" Margin="0,7,14,0" />
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,14">
                  <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}"
                            MinWidth="170" HorizontalAlignment="Left" />
                  <TextBlock Classes="hint"
                             Text="Cannot change between versions of the same product. Windows Installer will not upgrade across architectures." />
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Install folder" Margin="0,7,14,0" />
                <StackPanel Grid.Row="6" Grid.Column="1">
                  <TextBox Text="{Binding InstallFolder}" Watermark="defaults to the product name" />
                  <TextBlock Classes="hint" Text="Created under Program Files. Installs are always per-machine, because Intune runs as SYSTEM." />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================ Run -->
      <TabItem Header="Run">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Classes="h1" Text="Commands to run" />
            <TextBlock Classes="sub"
                       Text="Executables the package runs during install or uninstall. Each runs deferred and without impersonation, so it executes as SYSTEM with the payload already on disk." />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="CUSTOM ACTIONS" Margin="0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="AddRunButton" Content="Add command" />
                  <Button Name="RemoveRunButton" Content="Remove selected" Classes="quiet" />
                </StackPanel>
                <DataGrid Name="RunGrid" ItemsSource="{Binding Run}" Height="260"
                          AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Executable" Binding="{Binding ExePath}" Width="240" />
                    <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="*" />
                    <DataGridCheckBoxColumn Header="Ignore exit code" Binding="{Binding IgnoreExitCode}" Width="140" />
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock Classes="hint" Margin="0"
                           Text="Paths are relative to the install folder. An installer run this way is not tracked by Windows Installer, so uninstalling the MSI removes the payload but not whatever that installer wrote elsewhere - add an uninstall command for that." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================ Upgrade check -->
      <TabItem Header="Upgrade check">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Classes="h1" Text="Will Intune actually upgrade?" />
            <TextBlock Classes="sub"
                       Text="Compare a built package against the version already deployed. Every reason an Intune upgrade silently fails is visible in the two files before anything is deployed." />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="COMPARE AGAINST" Margin="0" />
                <DockPanel>
                  <Button Name="PickPreviousButton" Content="Previously shipped MSI…"
                          DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox Text="{Binding PreviousMsi}" Watermark="path to the MSI currently deployed" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="RunCheckButton" Content="Check against current build" />
                  <Button Name="PickCandidateButton" Content="…or pick a candidate MSI" Classes="quiet" />
                </StackPanel>

                <Border Classes="verdict" Classes.pass="{Binding VerdictIsGood}"
                        IsVisible="{Binding Verdict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Classes="verdicttext" Classes.pass="{Binding VerdictIsGood}"
                             Text="{Binding Verdict}" />
                </Border>

                <DataGrid ItemsSource="{Binding Checks}" Height="300" IsReadOnly="True"
                          AutoGenerateColumns="False" RowHeight="34"
                          IsVisible="{Binding HasChecks}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="86">
                      <DataGridTemplateColumn.CellTemplate>
                        <!--
                          A template column, not a text column: compiled bindings
                          cannot bind a DataGridTextColumn's Foreground to a row
                          property, and the status has to be readable at a glance.
                        -->
                        <DataTemplate x:DataType="vm:CheckRow">
                          <Border Classes="pill"
                                  Classes.pass="{Binding IsPass}"
                                  Classes.warn="{Binding IsWarn}"
                                  Classes.fail="{Binding IsFail}"
                                  MinWidth="48" Margin="12,0,0,0">
                            <TextBlock Classes="pilltext"
                                       Classes.pass="{Binding IsPass}"
                                       Classes.warn="{Binding IsWarn}"
                                       Classes.fail="{Binding IsFail}"
                                       Text="{Binding Mark}" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="200" />
                    <DataGridTemplateColumn Header="Detail" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:CheckRow">
                          <TextBlock Text="{Binding Detail}" ToolTip.Tip="{Binding Detail}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" Margin="12,0"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <Border Classes="empty" IsVisible="{Binding !HasChecks}" Height="220">
                  <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="empty" FontWeight="SemiBold" Text="Nothing compared yet" />
                    <TextBlock Classes="empty"
                               Text="Point at the MSI currently deployed, then check it against this build. Each rule Windows Installer applies to an upgrade is reported as PASS, WARN or FAIL." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================ Build -->
      <TabItem Header="Build">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}">
            <TextBlock Classes="h1" Text="Build" />
            <TextBlock Classes="sub" Text="The MSI is always produced. Everything else is optional." />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="eyebrow" Text="OUTPUT" Margin="0" />
                <DockPanel>
                  <Button Name="PickOutputButton" Content="Output…" DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox Text="{Binding OutputPath}" Watermark="where to write the .msi" />
                </DockPanel>

                <StackPanel Spacing="0">
                  <CheckBox IsChecked="{Binding EmitIntuneWin}" Content="Also produce a Win32 .intunewin package" />
                  <TextBlock Classes="hint" Margin="28,2,0,6"
                             Text="Not needed just to deploy an MSI: Intune reads the ProductCode itself and a line-of-business MSI upgrades on GUID and version alone. Choose this when you need something LOB MSI cannot do - supersedence, dependencies, requirement rules, a custom command line, or detection beyond the ProductCode." />
                  <TextBlock Classes="hint" Margin="28,0,0,0" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Text="Required for ring-based rollout: Intune deployment plans accept only Windows app (Win32) and Enterprise App Catalog payloads. A line-of-business MSI cannot be used in a deployment, and only the Required install intent is supported." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                  <Button Name="BuildButton" Content="Build MSI" Classes="primary"
                          IsEnabled="{Binding CanBuild}" />
                  <Button Name="OpenOutputButton" Content="Show output folder" Classes="quiet" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="eyebrow" Text="LOG" Margin="0" />
                <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                         Classes="mono" Height="240"
                         Background="{DynamicResource SunkenBrush}"
                         TextWrapping="NoWrap"
                         HorizontalAlignment="Stretch" VerticalContentAlignment="Top" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
