<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MsiMaker.App.ViewModels"
        x:Class="MsiMaker.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Background="{DynamicResource AppSurfaceBrush}"
        WindowStartupLocation="CenterScreen"
        Title="MsiMaker" Width="980" Height="720" MinWidth="760" MinHeight="480">

  <DockPanel>

    <!-- ================================================================ chrome -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource ChromePadding}">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
          <!--
            The mark, rather than a letter in a box: the same package glyph the
            payload step uses, so the product and the thing it makes share one
            piece of drawing.
          -->
          <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Width="28" Height="28"
                  BoxShadow="{DynamicResource RaisedShadow}">
            <Path Data="{StaticResource IconPackage}"
                  Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.3"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="None"
                  Width="16" Height="16"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="MsiMaker" FontSize="17" FontWeight="SemiBold" LetterSpacing="-0.2"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <Border Width="1" Height="15" Background="{DynamicResource BorderSubtleBrush}"
                  VerticalAlignment="Center" />
          <TextBlock Text="Build MSIs that upgrade cleanly in Intune" FontSize="12.5"
                     Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Name="OpenProjectButton" Classes="quiet">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Classes="icon" Data="{StaticResource IconFolder}" />
              <TextBlock Text="Open blueprint…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="SaveProjectButton">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Classes="icon" Data="{StaticResource IconSave}" />
              <TextBlock Text="Save blueprint…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ========================================================= step indicator -->
    <!--
      The wizard's spine, and the only navigation in the window. It replaces the
      tab strip rather than sitting beside it: numbered while ahead, ticked once
      satisfied, filled while current. Every step stays clickable - it is a
      suggested route, not a cage - and the two that can be skipped say so.
    -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,5">
      <ListBox Classes="steps" ItemsSource="{Binding Steps}"
               SelectedIndex="{Binding CurrentStep, Mode=TwoWay}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:WizardStep">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Border Classes="stepmark"
                      Classes.done="{Binding IsDone}"
                      Classes.current="{Binding IsCurrent}">
                <Panel>
                  <TextBlock Classes="stepnum" Text="{Binding NumberText}"
                             IsVisible="{Binding ShowsNumber}" />
                  <Path Classes="tick" Data="{StaticResource IconTickSmall}"
                        IsVisible="{Binding IsDone}" />
                </Panel>
              </Border>
              <TextBlock Classes="steplabel"
                         Classes.done="{Binding IsDone}"
                         Classes.current="{Binding IsCurrent}"
                         Text="{Binding Name}" />
              <TextBlock Classes="stepopt" Text="optional" IsVisible="{Binding ShowsOptional}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- =============================================================== footer -->
    <!--
      Docked, so it is on screen whatever the page above is doing. It carries
      everything about position at once: where you came from, what the app last
      did, which step this is, why Next is off if it is, and - named, never just
      "Next" - where the button is about to take you.
    -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,15">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <Button Grid.Column="0" Name="WizardBackButton" Classes="quiet"
                IsVisible="{Binding !IsFirstStep}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="icon" Data="{StaticResource IconArrowLeft}" />
            <TextBlock Text="Back" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9"
                    Margin="12,0" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                   Fill="{DynamicResource AccentBrush}" />
          <TextBlock Name="StatusText" Text="Ready" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <!-- Never a grey button on its own: say what is missing. -->
          <TextBlock Classes="blocked" Text="{Binding StepBlockReason}"
                     IsVisible="{Binding IsBlocked}" />
          <TextBlock Classes="steppos" Text="{Binding PositionLabel}" />

          <Button Name="WizardNextButton" Classes="primary"
                  IsVisible="{Binding !IsLastStep}" IsEnabled="{Binding CanAdvance}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding NextLabel}" VerticalAlignment="Center" />
              <Path Classes="icon" Data="{StaticResource IconArrowRight}" />
            </StackPanel>
          </Button>

          <!--
            The last step's primary action is the build itself, not another
            "Next" - the footer is the same object throughout, it just stops
            being navigation once there is nowhere left to go.
          -->
          <Button Name="BuildButton" Classes="primary"
                  IsVisible="{Binding IsLastStep}" IsEnabled="{Binding CanBuild}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon" Data="{StaticResource IconBuild}" />
              <TextBlock Text="Build MSI" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!--
      Still a TabControl underneath: it hosts and switches the pages exactly as
      before. Its own header strip is folded away by the template, and the step
      indicator drives SelectedIndex through the view model instead.
    -->
    <TabControl Name="MainTabs" SelectedIndex="{Binding CurrentStep, Mode=TwoWay}">

      <!-- ====================================================== 1. Start -->
      <!--
        First, because the cheapest way to package an awkward application is to
        start from somebody who has already been caught by it. The detail pane
        leads with the awkwardness prose for the same reason: the silent
        switches are in a vendor PDF somewhere, the trap is not.
      -->
      <TabItem Header="Start">
        <Grid Margin="{DynamicResource PagePadding}"
              RowDefinitions="Auto,*" ColumnDefinitions="300,16,*">

          <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="pageicon">
                <Path Classes="icon" Data="{StaticResource IconBook}" />
              </Border>
              <TextBlock Classes="h1" Text="Start here" Margin="0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Classes="sub" Margin="0,8,0,10"
                       Text="A preloaded blueprint is the fastest start when one fits: a working setup for an app that resists normal packaging, plus the reason why. Pick one below, hand it the file you downloaded, and you get a ready-to-edit blueprint." />

            <!--
              The list is the recommendation, but it is not the only way in, and
              an admin packaging something not in it must not feel stuck. So the
              two other routes are spelled out as real buttons, led by a line that
              says plainly the list is optional.
            -->
            <Border Classes="inner" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="hint" Margin="0" VerticalAlignment="Center"
                           Text="Not in the list? You don't have to pick one —" />
                <Button Name="StartBlankButton">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Classes="icon" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Start blank" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="hint" Margin="0" VerticalAlignment="Center" Text="or" />
                <Button Name="OpenProjectOnLibraryButton" Classes="quiet">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Classes="icon" Data="{StaticResource IconFolder}" />
                    <TextBlock Text="Open blueprint…" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ================================================= blueprint list -->
          <Border Grid.Row="1" Grid.Column="0" Classes="card" Margin="0" Padding="0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Text="PRELOADED BLUEPRINTS"
                         Margin="16,14,16,6" />

              <!--
                The library's own location: findable, but folded away by
                default. Expanded it is half the height of this card, and the
                list of blueprints is what the card is for.
              -->
              <Border DockPanel.Dock="Bottom" Classes="inner"
                      CornerRadius="0,0,9,9" BorderThickness="0,1,0,0" Padding="10,2">
                <Expander Header="Your own blueprints" IsExpanded="False"
                          HorizontalAlignment="Stretch" Background="Transparent"
                          BorderThickness="0" Padding="0">
                  <StackPanel Spacing="2" Margin="0,0,0,8">
                    <SelectableTextBlock Text="{Binding BlueprintUserDirectory}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Classes="hint" Margin="0,4,0,0"
                               Text="Drop blueprint JSON in that folder and it is read on the next start, or point MSIMAKER_BLUEPRINTS at a folder your team shares. A file that reuses a built-in id replaces the built-in one, so a vendor who changes a switch can be corrected today rather than in the next release." />
                    <TextBlock Classes="hint" IsVisible="{Binding HasBlueprintProblems}"
                               Foreground="{DynamicResource FailTextBrush}"
                               Text="{Binding BlueprintProblems}" />
                    <Button Name="OpenBlueprintsFolderButton" Content="Show blueprints folder"
                            Classes="quiet" Margin="0,8,0,0" HorizontalAlignment="Left" />
                  </StackPanel>
                </Expander>
              </Border>

              <!--
                A persistent scrollbar, not the thin auto-hiding overlay: when the
                library is taller than the card, the bar is the only cue that there
                is more below the fold, so it has to stay visible.
              -->
              <ListBox Classes="blueprints" ItemsSource="{Binding Blueprints}"
                       SelectedItem="{Binding SelectedBlueprint}"
                       ScrollViewer.AllowAutoHide="False"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       Background="Transparent" BorderThickness="0" Padding="7,0,7,8">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BlueprintRow">
                    <StackPanel Spacing="0">
                      <!--
                        A category header on the first row of each group. The list
                        is ordered by category, so this shows once per group and
                        turns a flat list into "Applications" and "Device & driver
                        tools" sections.
                      -->
                      <TextBlock Text="{Binding GroupLabel}" Classes="grouphead"
                                 IsVisible="{Binding IsGroupStart}" />
                      <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Vendor}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <!-- =============================================== blueprint detail -->
          <DockPanel Grid.Row="1" Grid.Column="2" IsVisible="{Binding HasSelectedBlueprint}">

            <!--
              Pinned rather than scrolled away with the prose. The awkwardness
              text is deliberately long, and the action it argues for has to
              stay on screen while it is being read.
            -->
            <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0" Padding="14,12">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Name="UseBlueprintButton" Classes="primary">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{StaticResource IconArrowRight}" />
                    <TextBlock Text="{Binding SelectedBlueprint.UseLabel}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <TextBlock Classes="hint" Margin="0" VerticalAlignment="Center"
                             Text="Replaces the current blueprint" />
                  <Button Classes="info">
                    <Button.Flyout>
                      <Flyout>
                        <TextBlock Classes="disclosure"
                                   Text="This replaces the current blueprint. The template carries a realistic version, which is not necessarily the version you downloaded - set the Version on the Identity tab to the one you actually have, because the ProductCode Intune detects on is derived from it." />
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <ScrollViewer>
            <StackPanel Spacing="0" Margin="0,0,4,0">

              <Border Classes="card">
                <StackPanel Spacing="16">

                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding SelectedBlueprint.Name}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Classes="hint" Margin="0"
                               Text="{Binding SelectedBlueprint.Vendor}" />
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Text="WHY THIS ONE IS AWKWARD" Margin="0" />
                    <TextBlock Classes="prose" Text="{Binding SelectedBlueprint.Awkwardness}" />
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Classes="eyebrow" Text="WHAT IT BUILDS" Margin="0" />
                    <TextBlock Classes="prose" Text="{Binding SelectedBlueprint.Description}" />
                  </StackPanel>

                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="16">
                  <TextBlock Classes="eyebrow" Text="WHERE THE PAYLOAD COMES FROM" Margin="0" />

                  <StackPanel Spacing="4" IsVisible="{Binding SelectedBlueprint.HasDownloadUrl}">
                    <TextBlock Classes="label" Text="Download" Margin="0" />
                    <!--
                      Selectable rather than a hyperlink, so the address is
                      always readable and copyable; the button is the only thing
                      that hands anything to the shell, and only http or https.
                    -->
                    <SelectableTextBlock Text="{Binding SelectedBlueprint.DownloadUrl}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Name="OpenBlueprintUrlButton" Classes="quiet"
                            HorizontalAlignment="Left" Margin="0,4,0,0"
                            IsEnabled="{Binding SelectedBlueprint.CanOpenDownloadUrl}">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="icon" Data="{StaticResource IconExternal}" />
                        <TextBlock Text="Open in browser" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <StackPanel Spacing="4" IsVisible="{Binding SelectedBlueprint.HasDownloadNotes}">
                    <TextBlock Classes="label" Text="Getting hold of it" Margin="0" />
                    <TextBlock Classes="prose" Text="{Binding SelectedBlueprint.DownloadNotes}" />
                  </StackPanel>

                  <StackPanel Spacing="4" IsVisible="{Binding SelectedBlueprint.HasSetupFileHint}">
                    <TextBlock Classes="label" Text="What the payload should look like" Margin="0" />
                    <TextBlock Classes="prose" Text="{Binding SelectedBlueprint.SetupFileHint}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card" IsVisible="{Binding SelectedBlueprint.HasNotes}">
                <StackPanel Spacing="10">
                  <TextBlock Classes="eyebrow" Text="NOTES" Margin="0" />
                  <ItemsControl ItemsSource="{Binding SelectedBlueprint.Notes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,7">
                          <Border Grid.Column="0" Width="3" Height="3" CornerRadius="999"
                                  Margin="2,7,9,0" VerticalAlignment="Top"
                                  Background="{DynamicResource BorderStrongBrush}" />
                          <TextBlock Grid.Column="1" Text="{Binding}" Classes="hint" Margin="0"
                                     MaxWidth="620" HorizontalAlignment="Left" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="hint" Margin="0" Text="{Binding SelectedBlueprint.Origin}" />
                </StackPanel>
              </Border>

            </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <Border Grid.Row="1" Grid.Column="2" Classes="empty"
                  IsVisible="{Binding !HasSelectedBlueprint}" VerticalAlignment="Top">
            <StackPanel Spacing="6">
              <Viewbox Classes="mark">
                <Path Classes="icon mark" Data="{StaticResource IconBook}" />
              </Viewbox>
              <TextBlock Classes="empty" FontWeight="SemiBold" Text="No blueprint selected" />
              <TextBlock Classes="empty"
                         Text="Choose an application on the left to see why it is awkward and what the blueprint does about it." />
            </StackPanel>
          </Border>

        </Grid>
      </TabItem>

      <!-- ==================================================== 2. Payload -->
      <TabItem Header="Payload">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}"
                      MaxWidth="{StaticResource PageMeasure}">

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="pageicon">
                <Path Classes="icon" Data="{StaticResource IconPackage}" />
              </Border>
              <TextBlock Classes="h1" Text="What are you packaging?" Margin="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="sub"
                       Text="Add the files to install. If the payload is an installer executable, analyse it and MsiMaker will identify the framework and propose the switches that make it run silently." />

            <Border Classes="card">
              <StackPanel Spacing="16">

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="eyebrow" Text="PAYLOAD FILES" Margin="0" VerticalAlignment="Center" />
                  <Button Classes="info">
                    <Button.Flyout>
                      <Flyout>
                        <TextBlock Classes="disclosure"
                                   Text="Adding a .exe or .msi runs the installer detective automatically. Re-analyse only when several installers were added at once and the wrong one was picked." />
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="AddFilesButton">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Classes="icon" Data="{StaticResource IconPlus}" />
                      <TextBlock Text="Add files…" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Name="AnalyseButton" Classes="quiet">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Classes="icon" Data="{StaticResource IconSearch}" />
                      <TextBlock Text="Re-analyse…" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Name="RemoveFileButton" Classes="quiet">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Classes="icon" Data="{StaticResource IconTrash}" />
                      <TextBlock Text="Remove selected" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <Border Classes="inner" IsVisible="{Binding HasAnalysis}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding AnalysisSummary}" FontWeight="SemiBold" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Classes="mono" Text="{Binding AnalysisDetail}" />
                  </StackPanel>
                </Border>

                <DataGrid Name="FilesGrid" ItemsSource="{Binding Files}" MinHeight="140" MaxHeight="260"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          IsVisible="{Binding HasFiles}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Installs as" Binding="{Binding Target}" Width="1.1*" />
                    <DataGridTemplateColumn Header="Source" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:FileRow">
                          <!-- Elided from the left: the tail of a source path is the part worth reading. -->
                          <TextBlock Text="{Binding Source}" ToolTip.Tip="{Binding Source}"
                                     TextTrimming="PrefixCharacterEllipsis"
                                     VerticalAlignment="Center" Margin="12,0"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
                  </DataGrid.Columns>
                </DataGrid>

                <Border Classes="empty" IsVisible="{Binding !HasFiles}" MinHeight="150" MaxHeight="260">
                  <StackPanel Spacing="6" VerticalAlignment="Center">
                    <Viewbox Classes="mark">
                      <Path Classes="icon mark" Data="{StaticResource IconPackage}" />
                    </Viewbox>
                    <TextBlock Classes="empty" FontWeight="SemiBold" Text="No payload yet" />
                    <TextBlock Classes="empty"
                               Text="Add the installer you want to wrap, plus any config files it needs. An .exe or .msi is analysed the moment it is added." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- =================================================== 3. Identity -->
      <!--
        Three cards rather than one seven-row form. The grouping is the point:
        what the thing is called, how Intune recognises it between versions, and
        where it lands - and the rules behind each field now sit one click away
        under the label instead of as a paragraph beneath every box.
      -->
      <TabItem Header="Identity">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}"
                      MaxWidth="{StaticResource PageMeasure}">

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="pageicon">
                <Path Classes="icon" Data="{StaticResource IconTag}" />
              </Border>
              <TextBlock Classes="h1" Text="Package identity" Margin="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="sub"
                       Text="These four values decide whether Intune upgrades your app or quietly ignores it. MsiMaker manages the ProductCode for you." />

            <Border Classes="card">
              <StackPanel Spacing="14">
                <TextBlock Classes="eyebrow" Text="THE APPLICATION" Margin="0" />
                <Grid ColumnDefinitions="168,*" RowDefinitions="Auto,Auto,Auto">

                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Product name"
                             Margin="0,8,14,0" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProductName}"
                           Watermark="as it appears in Programs and Features" Margin="0,0,0,12" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Manufacturer"
                             Margin="0,8,14,0" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Manufacturer}"
                           Watermark="the publisher shown to the fleet" Margin="0,0,0,12" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Version"
                             Margin="0,8,14,0" />
                  <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBox Text="{Binding Version}" />
                    <!--
                      The one hint that earns its place on screen: it changes as
                      the box is typed into, and a fourth field silently doing
                      nothing is exactly what it is there to catch.
                    -->
                    <TextBlock Classes="hint" Text="{Binding VersionNote}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="14">
                <TextBlock Classes="eyebrow" Text="HOW INTUNE RECOGNISES IT" Margin="0" />
                <Grid ColumnDefinitions="168,*" RowDefinitions="Auto,Auto">

                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                              Margin="0,8,14,0" VerticalAlignment="Top">
                    <TextBlock Classes="label" Text="UpgradeCode" Margin="0" />
                    <Button Classes="info">
                      <Button.Flyout>
                        <Flyout>
                          <TextBlock Classes="disclosure"
                                     Text="Stable for the lifetime of the product. Every version must carry this same value, or the old build is never removed and you end up with two entries in Programs and Features." />
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                    <Button Name="NewUpgradeCodeButton" Content="New" DockPanel.Dock="Right" Margin="8,0,0,0" />
                    <TextBox Text="{Binding UpgradeCode}" Classes="mono" />
                  </DockPanel>

                  <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                              Margin="0,8,14,0" VerticalAlignment="Top">
                    <TextBlock Classes="label" Text="ProductCode" Margin="0" />
                    <Button Classes="info">
                      <Button.Flyout>
                        <Flyout>
                          <TextBlock Classes="disclosure"
                                     Text="Derived from the UpgradeCode and version, so it changes exactly when the version changes. Intune detects on this value; a ProductCode that fails to change is the single most common reason an upgrade never happens." />
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProductCodePreview}"
                           IsReadOnly="True" Classes="mono"
                           Background="{DynamicResource SunkenBrush}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="14">
                <TextBlock Classes="eyebrow" Text="WHERE IT LANDS" Margin="0" />
                <Grid ColumnDefinitions="168,*" RowDefinitions="Auto,Auto">

                  <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                              Margin="0,8,14,0" VerticalAlignment="Top">
                    <TextBlock Classes="label" Text="Platform" Margin="0" />
                    <Button Classes="info">
                      <Button.Flyout>
                        <Flyout>
                          <TextBlock Classes="disclosure"
                                     Text="Cannot change between versions of the same product. Windows Installer will not upgrade across architectures." />
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Platforms}"
                            SelectedItem="{Binding Platform}" MinWidth="170"
                            HorizontalAlignment="Left" Margin="0,0,0,12" />

                  <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                              Margin="0,8,14,0" VerticalAlignment="Top">
                    <TextBlock Classes="label" Text="Install folder" Margin="0" />
                    <Button Classes="info">
                      <Button.Flyout>
                        <Flyout>
                          <TextBlock Classes="disclosure"
                                     Text="Created under Program Files. Installs are always per-machine, because Intune runs as SYSTEM." />
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InstallFolder}"
                           Watermark="defaults to the product name" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- =================================================== 4. Commands -->
      <TabItem Header="Arguments">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}"
                      MaxWidth="{StaticResource PageMeasure}">

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="pageicon">
                <Path Classes="icon" Data="{StaticResource IconTerminal}" />
              </Border>
              <TextBlock Classes="h1" Text="Arguments" Margin="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="sub"
                       Text="The programs this package runs during install or uninstall, and the arguments they run with - the silent switches for a wrapped installer, say. Each runs as SYSTEM with the payload already on disk." />

            <Border Classes="card">
              <StackPanel Spacing="16">

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="eyebrow" Text="PROGRAMS THIS PACKAGE RUNS" Margin="0" VerticalAlignment="Center" />
                  <Button Classes="info">
                    <Button.Flyout>
                      <Flyout>
                        <TextBlock Classes="disclosure"
                                   Text="Paths are relative to the install folder. An installer run this way is not tracked by Windows Installer, so uninstalling the MSI removes the payload but not whatever that installer wrote elsewhere - add an uninstall command for that." />
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>

                <!--
                  The install-location surprise: a wrapped installer places files
                  where its own switch says, not where the Install folder field
                  says. Removing the switch does not fall back to a prompt or to
                  that field - it falls back to the vendor's default.
                -->
                <Border Classes="inner">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Path Classes="icon" Data="{StaticResource IconAlert}"
                          VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Classes="disclosure" TextWrapping="Wrap"
                               Text="These are the plain arguments the program runs with - the silent switches. Where a wrapped installer puts its files is chosen separately when you build (a fixed folder, or the installer&apos;s own default), so you do not set the install directory here." />
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="AddRunButton">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Classes="icon" Data="{StaticResource IconPlus}" />
                      <TextBlock Text="Add command" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Name="RemoveRunButton" Classes="quiet">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Classes="icon" Data="{StaticResource IconTrash}" />
                      <TextBlock Text="Remove selected" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <!--
                  Shown at a real height when there are commands, so imported
                  rows and their arguments are fully visible (a DataGrid in a
                  StackPanel needs a definite height or it renders its rows too
                  short). When empty it is replaced by a one-line hint, so a
                  task-only blueprint like HPIA does not carry a tall blank box
                  that buries the scheduled-task card below it.
                -->
                <DataGrid Name="RunGrid" ItemsSource="{Binding Run}"
                          IsVisible="{Binding HasRunActions}" MinHeight="120" MaxHeight="280"
                          AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Executable" Binding="{Binding ExePath}" Width="240" />
                    <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="*" />
                    <DataGridCheckBoxColumn Header="Ignore exit code" Binding="{Binding IgnoreExitCode}" Width="140" />
                  </DataGrid.Columns>
                </DataGrid>

                <TextBlock Classes="hint" Margin="0" IsVisible="{Binding !HasRunActions}"
                           Text="No install-time commands. Most packages need none - add one only if this package must run something during install or uninstall." />
              </StackPanel>
            </Border>

            <!--
              A scheduled task is uncommon - only the device/driver tools use one -
              so this card keeps the same position below the commands for every
              blueprint rather than jumping to the top when it happens to exist.
              It is shown only when the blueprint defines a task.
            -->
            <Border Classes="card" IsVisible="{Binding HasTasks}">
              <StackPanel Spacing="16">

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="eyebrow" Text="SCHEDULED TASK" Margin="0" VerticalAlignment="Center" />
                  <Button Classes="info">
                    <Button.Flyout>
                      <Flyout>
                        <TextBlock Classes="disclosure"
                                   Text="This task is registered at install and runs later on its own schedule, as SYSTEM. For tools like HP Image Assistant it is where the real work happens - the analyse-and-update run - so this command, not an install-time one, is what does the job. Editing the arguments changes what gets scheduled." />
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Tasks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaskRow">
                      <Border Classes="inner" Margin="0,0,0,10">
                        <StackPanel Spacing="10">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Classes="hint" Margin="0" Text="{Binding ScheduleSummary}" />
                            <TextBlock Classes="hint" Margin="0" IsVisible="{Binding HasDescription}"
                                       Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>

                          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Runs"
                                       Margin="0,4,14,0" />
                            <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExePath}"
                                                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                                 Margin="0,0,0,10" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextSecondaryBrush}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Arguments"
                                       Margin="0,6,14,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Arguments}"
                                     AcceptsReturn="False" TextWrapping="Wrap"
                                     FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                     Watermark="switches this task runs with" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================================== 5. Upgrade check -->
      <TabItem Header="Upgrade check">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}"
                      MaxWidth="{StaticResource PageMeasure}">

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="pageicon">
                <Path Classes="icon" Data="{StaticResource IconCheckCircle}" />
              </Border>
              <TextBlock Classes="h1" Text="Will Intune actually upgrade?" Margin="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="sub"
                       Text="Compare a built package against the version already deployed. Every reason an Intune upgrade silently fails is visible in the two files before anything is deployed." />

            <Border Classes="card">
              <StackPanel Spacing="16">
                <TextBlock Classes="eyebrow" Text="COMPARE AGAINST" Margin="0" />

                <DockPanel>
                  <Button Name="PickPreviousButton" Content="Previously shipped MSI…"
                          DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox Text="{Binding PreviousMsi}" Watermark="path to the MSI currently deployed" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Name="RunCheckButton">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Classes="icon" Data="{StaticResource IconCheckCircle}" />
                      <TextBlock Text="Check against current build" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Name="PickCandidateButton" Content="…or pick a candidate MSI" Classes="quiet" />
                </StackPanel>

                <Border Classes="verdict" Classes.pass="{Binding VerdictIsGood}"
                        IsVisible="{Binding Verdict, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Path Grid.Column="0" Classes="icon" Margin="0,1,11,0"
                          Data="{StaticResource IconCheckCircle}"
                          IsVisible="{Binding VerdictIsGood}" />
                    <Path Grid.Column="0" Classes="icon" Margin="0,1,11,0"
                          Data="{StaticResource IconAlert}"
                          IsVisible="{Binding !VerdictIsGood}" />
                    <TextBlock Grid.Column="1" Classes="verdicttext" Classes.pass="{Binding VerdictIsGood}"
                               Text="{Binding Verdict}" />
                  </Grid>
                </Border>

                <DataGrid ItemsSource="{Binding Checks}" MinHeight="150" MaxHeight="300" IsReadOnly="True"
                          AutoGenerateColumns="False" RowHeight="34"
                          IsVisible="{Binding HasChecks}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="92">
                      <DataGridTemplateColumn.CellTemplate>
                        <!--
                          A template column, not a text column: compiled bindings
                          cannot bind a DataGridTextColumn's Foreground to a row
                          property, and the status has to be readable at a glance.
                        -->
                        <DataTemplate x:DataType="vm:CheckRow">
                          <Border Classes="pill"
                                  Classes.pass="{Binding IsPass}"
                                  Classes.warn="{Binding IsWarn}"
                                  Classes.fail="{Binding IsFail}"
                                  MinWidth="52" Margin="12,0,0,0">
                            <TextBlock Classes="pilltext"
                                       Classes.pass="{Binding IsPass}"
                                       Classes.warn="{Binding IsWarn}"
                                       Classes.fail="{Binding IsFail}"
                                       Text="{Binding Mark}" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="200" />
                    <DataGridTemplateColumn Header="Detail" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:CheckRow">
                          <TextBlock Text="{Binding Detail}" ToolTip.Tip="{Binding Detail}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" Margin="12,0"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>

                <Border Classes="empty" IsVisible="{Binding !HasChecks}" MinHeight="150" MaxHeight="230">
                  <StackPanel Spacing="6" VerticalAlignment="Center">
                    <Viewbox Classes="mark">
                      <Path Classes="icon mark" Data="{StaticResource IconCompare}" />
                    </Viewbox>
                    <TextBlock Classes="empty" FontWeight="SemiBold" Text="Nothing compared yet" />
                    <TextBlock Classes="empty"
                               Text="Point at the MSI currently deployed, then check it against this build. Each rule Windows Installer applies to an upgrade is reported as PASS, WARN or FAIL." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ====================================================== 6. Build -->
      <!--
        The build action itself lives in the wizard footer, because that is
        where the primary action of every other step lives too and this is
        simply the last of them.
      -->
      <TabItem Header="Build">
        <ScrollViewer>
          <StackPanel Margin="{DynamicResource PagePadding}"
                      MaxWidth="{StaticResource PageMeasure}">

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="pageicon">
                <Path Classes="icon" Data="{StaticResource IconBuild}" />
              </Border>
              <TextBlock Classes="h1" Text="Build" Margin="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="sub" Text="The MSI is always produced. Everything else is optional." />

            <!--
              The build result, made impossible to miss. A finished build used to
              leave only a status line and a wall of log text that looked no
              different from before it ran; this banner says plainly that it is
              done, names the file, and puts the folder one click away.
            -->
            <Border Classes="verdict" Classes.pass="{Binding BuildSucceeded}"
                    IsVisible="{Binding HasBuildResult}" Margin="0,4,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                <Path Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Classes="icon" Margin="0,2,13,0"
                      Data="{StaticResource IconCheckCircle}"
                      IsVisible="{Binding BuildSucceeded}" />
                <Path Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Classes="icon" Margin="0,2,13,0"
                      Data="{StaticResource IconAlert}"
                      IsVisible="{Binding !BuildSucceeded}" />

                <TextBlock Grid.Row="0" Grid.Column="1" Classes="verdicttext"
                           Classes.pass="{Binding BuildSucceeded}"
                           Text="{Binding BuildHeadline}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Margin="0,3,0,0"
                           Text="{Binding BuildResultPath}"
                           IsVisible="{Binding BuildResultPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="disclosure" Margin="0,6,0,0"
                           Text="{Binding BuildResultDetail}"
                           IsVisible="{Binding BuildResultDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                        Name="ResultShowFolderButton" Classes="quiet"
                        VerticalAlignment="Top" Margin="12,0,0,0"
                        IsVisible="{Binding BuildSucceeded}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Classes="icon" Data="{StaticResource IconFolder}" />
                    <TextBlock Text="Show folder" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="16">
                <TextBlock Classes="eyebrow" Text="OUTPUT" Margin="0" />

                <DockPanel>
                  <Button Name="OpenOutputButton" Classes="quiet" DockPanel.Dock="Right" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Path Classes="icon" Data="{StaticResource IconFolder}" />
                      <TextBlock Text="Show folder" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Name="PickOutputButton" Content="Output…" DockPanel.Dock="Right" Margin="8,0,0,0" />
                  <TextBox Text="{Binding OutputPath}" Watermark="where to write the .msi" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding ShowInstallWizard}"
                            Content="Include a setup wizard (lets people choose the install folder)" />
                  <Button Classes="info">
                    <Button.Flyout>
                      <Flyout>
                        <TextBlock Classes="disclosure"
                                   Text="Adds a Welcome, a destination-folder page with Browse, a ready-to-install page, progress, and a completion screen for anyone who runs the MSI by hand. The folder they choose is passed through to a wrapped vendor installer whose switch is recognised (NSIS /D=, Inno /DIR=, INSTALLDIR=, APPDIR=), so the app installs where they picked - pre-filled to Program Files under the product name. A silent deployment (Intune, or msiexec /qn) never shows the wizard, so it costs nothing there; turn it off for a package meant only to be pushed silently." />
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding EmitIntuneWin}"
                            Content="Also produce a Win32 .intunewin package" />
                  <Button Classes="info">
                    <Button.Flyout>
                      <Flyout>
                        <StackPanel Spacing="10">
                          <TextBlock Classes="disclosure"
                                     Text="Not needed just to deploy an MSI: Intune reads the ProductCode itself and a line-of-business MSI upgrades on GUID and version alone. Choose this when you need something LOB MSI cannot do - supersedence, dependencies, requirement rules, a custom command line, or detection beyond the ProductCode." />
                          <TextBlock Classes="disclosure" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Text="Required for ring-based rollout: Intune deployment plans accept only Windows app (Win32) and Enterprise App Catalog payloads. A line-of-business MSI cannot be used in a deployment, and only the Required install intent is supported." />
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ========================================= signing -->
            <Border Classes="card">
              <StackPanel Spacing="16">
                <TextBlock Classes="eyebrow" Text="SIGNING" Margin="0" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox IsChecked="{Binding SignEnabled}" Content="Sign the package" />
                  <Button Classes="info">
                    <Button.Flyout>
                      <Flyout>
                        <TextBlock Classes="disclosure"
                                   Text="Signing runs after the MSI is written and before anything is packaged around it, because any later edit to the database invalidates the signature." />
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>

                <StackPanel Spacing="16" Margin="28,0,0,0" IsVisible="{Binding SignEnabled}">

                  <!--
                    Availability first. Every mode drives an external signer, so
                    a missing one is the single failure that makes the rest of
                    this section pointless, and it is invisible otherwise.
                  -->
                  <Border Classes="inner">
                    <StackPanel Spacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="pill"
                                Classes.pass="{Binding SignerFound}"
                                Classes.fail="{Binding !SignerFound}">
                          <TextBlock Classes="pilltext"
                                     Classes.pass="{Binding SignerFound}"
                                     Classes.fail="{Binding !SignerFound}"
                                     Text="{Binding SignerBadge}" />
                        </Border>
                        <TextBlock Text="Signer" Classes="label" Margin="0" VerticalAlignment="Center" />
                        <Button Name="RecheckSignerButton" Classes="quiet">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Data="{StaticResource IconSearch}" />
                            <TextBlock Text="Check again" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </StackPanel>
                      <TextBlock Classes="mono" Text="{Binding SignerStatus}" />
                    </StackPanel>
                  </Border>

                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="Key material" Margin="0" />
                    <ComboBox ItemsSource="{Binding SigningModeNames}"
                              SelectedItem="{Binding SigningModeName}"
                              MinWidth="240" HorizontalAlignment="Left" />
                  </StackPanel>

                  <!-- PFX file -->
                  <StackPanel Spacing="16" IsVisible="{Binding IsPfxMode}">
                    <DockPanel>
                      <Button Name="PickCertificateButton" Content="Certificate…"
                              DockPanel.Dock="Right" Margin="8,0,0,0" />
                      <TextBox Text="{Binding CertificatePath}"
                               Watermark="path to the PFX to sign with" />
                    </DockPanel>

                    <StackPanel Spacing="4">
                      <!--
                        The single most dangerous field in the window. It is
                        named for what it takes - a variable name - in the label,
                        the watermark and the disclosure, because a password
                        typed here would be written into the project file and
                        committed.
                      -->
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="label" Margin="0"
                                   Text="Name of the environment variable holding the password" />
                        <Button Classes="info">
                          <Button.Flyout>
                            <Flyout>
                              <TextBlock Classes="disclosure"
                                         Text="This is a variable name, not the password. MsiMaker reads the password from that variable on the machine doing the build, and never stores it. A blueprint file belongs in source control, and a secret written into one would go to source control with it - which is why there is no password box here and no password field in the blueprint format." />
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                      <TextBox Text="{Binding PasswordEnvironmentVariable}" Classes="mono"
                               Watermark="for example MSIMAKER_PFX_PASSWORD" />
                    </StackPanel>
                  </StackPanel>

                  <!-- Windows certificate store -->
                  <StackPanel Spacing="4" IsVisible="{Binding IsStoreMode}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="label" Text="Certificate thumbprint" Margin="0" />
                      <Button Classes="info">
                        <Button.Flyout>
                          <Flyout>
                            <TextBlock Classes="disclosure"
                                       Text="The certificate must already be installed on the machine doing the build, in a store the build account can read. Nothing secret is stored in the blueprint: only the thumbprint that selects it." />
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                    <TextBox Text="{Binding Thumbprint}" Classes="mono"
                             Watermark="SHA-1 thumbprint of a certificate in the Windows store" />
                  </StackPanel>

                  <!-- Azure Trusted Signing -->
                  <StackPanel Spacing="16" IsVisible="{Binding IsAzureMode}">

                    <Border Classes="verdict warn">
                      <Grid ColumnDefinitions="Auto,*">
                        <Path Grid.Column="0" Classes="icon" Data="{StaticResource IconAlert}"
                              Margin="0,1,11,0" />
                        <StackPanel Grid.Column="1" Spacing="5">
                          <TextBlock Classes="verdicttext warn"
                                     Text="Implemented, but never verified against a real account." />
                          <TextBlock Classes="verdicttext warn" FontWeight="Normal" FontSize="12.5"
                                     Text="The command line signtool is given is covered by tests, but no package has been signed through an actual Trusted Signing account from here. Treat the first run as something to prove on one package, not as a step in a fleet build." />
                          <TextBlock Classes="verdicttext warn" FontWeight="Normal" FontSize="12.5"
                                     Text="Credentials are not blueprint settings and cannot be entered here. They come from the ambient Azure credential chain - AZURE_TENANT_ID, AZURE_CLIENT_ID and AZURE_CLIENT_SECRET, or an interactive az login - so the private key never reaches the build machine at all." />
                        </StackPanel>
                      </Grid>
                    </Border>

                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="label" Text="Account endpoint" Margin="0" />
                        <Button Classes="info">
                          <Button.Flyout>
                            <Flyout>
                              <TextBlock Classes="disclosure"
                                         Text="The region in the host must match the region the Trusted Signing account was created in." />
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                      <TextBox Text="{Binding AzureEndpoint}" Classes="mono"
                               Watermark="https://eus.codesigning.azure.net/" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="Code signing account name" Margin="0" />
                      <TextBox Text="{Binding AzureCodeSigningAccountName}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="label" Text="Certificate profile name" Margin="0" />
                        <Button Classes="info">
                          <Button.Flyout>
                            <Flyout>
                              <TextBlock Classes="disclosure"
                                         Text="The profile, not the blueprint, decides which identity the signature carries." />
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                      <TextBox Text="{Binding AzureCertificateProfileName}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="label" Text="Dlib path (optional)" Margin="0" />
                        <Button Classes="info">
                          <Button.Flyout>
                            <Flyout>
                              <TextBlock Classes="disclosure"
                                         Text="Only needed when the Microsoft.Trusted.Signing.Client package sits somewhere the NuGet cache sweep will not look. Signing goes through signtool's dlib hook, so this mode needs the Windows SDK; osslsigncode cannot do it." />
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </StackPanel>
                      <DockPanel>
                        <Button Name="PickDlibButton" Content="Dlib…"
                                DockPanel.Dock="Right" Margin="8,0,0,0" />
                        <TextBox Text="{Binding AzureDlibPath}" Classes="mono"
                                 Watermark="leave empty to find Azure.CodeSigning.Dlib.dll in the NuGet cache" />
                      </DockPanel>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="label" Text="Timestamp URL" Margin="0" />
                      <Button Classes="info">
                        <Button.Flyout>
                          <Flyout>
                            <TextBlock Classes="disclosure"
                                       Text="Without a timestamp the signature stops being trusted the day the certificate expires, rather than covering everything signed while it was valid." />
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </StackPanel>
                    <TextBox Text="{Binding TimestampUrl}" Classes="mono"
                             Watermark="http://timestamp.digicert.com" />
                  </StackPanel>

                </StackPanel>

              </StackPanel>
            </Border>

            <!--
              Collapsed by default and modest when open: on a short window the
              log used to push the Build button off the bottom of the screen,
              and it has nothing in it until a build has run anyway.
            -->
            <Expander Name="LogExpander" Header="Log" IsExpanded="False"
                      HorizontalAlignment="Stretch" Margin="0,0,0,8">
              <TextBox Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                       Classes="mono" MinHeight="110" MaxHeight="220"
                       Background="{DynamicResource SunkenBrush}"
                       TextWrapping="NoWrap"
                       HorizontalAlignment="Stretch" VerticalContentAlignment="Top" />
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
