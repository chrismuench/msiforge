<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MsiForge.Core</RootNamespace>
  </PropertyGroup>

  <!--
    The blueprint library ships inside the assembly so the CLI stays a single file
    that works on a machine with no network and no install step. LogicalName is
    pinned so the resource names do not depend on where the files sit on disk.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../blueprints/*.json"
                      LogicalName="MsiForge.Core.Blueprints.%(Filename).json" />
  </ItemGroup>

  <!--
    PKCS#7 and RFC 3161, for signing an MSI in process. Not in the shared
    framework, so it has to be asked for - but it is pure managed code from
    Microsoft that runs identically on macOS, which is the whole point: signing
    now needs nothing installed on the build machine.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.0" />
  </ItemGroup>
</Project>
